# Backend
NODE_ENV=development
BACK_PORT=4000
JWT_SECRET=replace_with_random_secret
AUTH_MODE=hybrid

# Database
DB_USER=gestion_user
DB_PASSWORD=replace_db_password
DB_NAME=gestion_tiempo
DB_HOST=db
DB_PORT=5432
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=2000
DB_POOL_KEEPALIVE=true

# CORS / Front
CORS_ORIGINS=http://localhost:3000
FRONT_PORTAL_BASE=http://localhost:3000/index.html

# Azure Entra ID / SSO
AZURE_TENANT_ID=replace_tenant_id
AZURE_CLIENT_ID=replace_client_id
AZURE_CLIENT_SECRET=replace_client_secret
AZURE_ALLOWED_GROUPS=replace_group_ids_comma_separated

# Email
EMAIL_PROVIDER=graph
EMAIL_FALLBACK_SMTP=false
GRAPH_SENDER_USER=replace_sender@company.com
EMAIL_TO_CONTABILIDAD=replace_accounting@company.com

# OneDrive
ONEDRIVE_ENABLED=true
ONEDRIVE_TARGET_USER=admin.apps@silverconsulting.com.co
ONEDRIVE_ROOT_FOLDER=AdjuntosCuentasCobro
