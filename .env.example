# Backend
NODE_ENV=development
BACK_PORT=4000
JWT_SECRET=replace_with_random_secret
AUTH_MODE=hybrid

# Database
DB_USER=gestion_user
DB_PASSWORD=replace_db_password
DB_NAME=gestion_tiempo
DB_HOST=db
DB_PORT=5432
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=2000
DB_POOL_KEEPALIVE=true

# CORS / Front
CORS_ORIGINS=http://localhost:3000
FRONT_PORTAL_BASE=http://localhost:3000/index.html

# Azure Entra ID / SSO
AZURE_TENANT_ID=replace_tenant_id
AZURE_CLIENT_ID=replace_client_id
AZURE_CLIENT_SECRET=replace_client_secret
AZURE_ALLOWED_GROUPS=replace_group_ids_comma_separated

# Email
EMAIL_PROVIDER=graph
EMAIL_FALLBACK_SMTP=false
GRAPH_SENDER_USER=replace_sender@company.com
EMAIL_TO_CONTABILIDAD=replace_accounting@company.com

# OneDrive
ONEDRIVE_ENABLED=true
ONEDRIVE_TARGET_USER=admin.apps@silverconsulting.com.co
ONEDRIVE_ROOT_FOLDER=AdjuntosCuentasCobro

# Click&Sign (Lleida.net)
CLICKSIGN_API_BASE=https://api.lleida.net/cs/v1
CLICKSIGN_API_KEY=replace_clicksign_api_key
CLICKSIGN_USER=replace_clicksign_user
CLICKSIGN_CONFIG_ID=101042
CLICKSIGN_WEBHOOK_TOKEN=replace_webhook_secret
CLICKSIGN_SIGNATURE_CB_URL=https://replace_backend_public_url/webhooks/clicksign/signature?token=replace_webhook_secret
# Opcional: URL directa del PDF firmado (placeholders: {request_id}, {contract_id}, {public_id})
CLICKSIGN_SIGNED_FILE_URL_TEMPLATE=
CLICKSIGN_SIGNATORY_CB_URL=
CLICKSIGN_SIGNATORY_EMAIL_CB_URL=
DEBUG_CLICKSIGN_TOKEN=replace_debug_token
