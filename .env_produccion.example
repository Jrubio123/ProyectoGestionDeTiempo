# Backend
NODE_ENV=production
BACK_PORT=4000
JWT_SECRET=replace_with_random_secret
AUTH_MODE=ms_only

# Database (Azure PostgreSQL Flexible Server)
DB_USER=replace_db_user
DB_PASSWORD=replace_db_password
DB_NAME=postgres
DB_HOST=replace_flexible_server_host
DB_PORT=5432
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=false
DB_POOL_MAX=20
DB_POOL_MIN=0
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=2000
DB_POOL_KEEPALIVE=true

# CORS / Front
CORS_ORIGINS=https://replace_frontend.azurestaticapps.net,https://replace_frontend_alt.azurestaticapps.net
FRONT_PORTAL_BASE=https://replace_frontend.azurestaticapps.net/index.html

# Azure Entra ID / SSO
AZURE_TENANT_ID=replace_tenant_id
AZURE_CLIENT_ID=replace_client_id
AZURE_CLIENT_SECRET=replace_client_secret
AZURE_ALLOWED_GROUPS=replace_group_ids_comma_separated
AZURE_DEVOPS_TENANT_ID=replace_tenant_id
AZURE_DEVOPS_CLIENT_ID=replace_azure_devops_client_id
AZURE_DEVOPS_CLIENT_SECRET=replace_azure_devops_client_secret
AZURE_DEVOPS_ORGANIZATION=fabricadev

# Email
EMAIL_PROVIDER=graph
EMAIL_FALLBACK_SMTP=false
GRAPH_SENDER_USER=replace_sender@company.com
EMAIL_TO_CONTABILIDAD=replace_accounting@company.com

# OneDrive
ONEDRIVE_ENABLED=true
ONEDRIVE_TARGET_USER=replace_target_user@company.com
ONEDRIVE_ROOT_FOLDER=AdjuntosCuentasCobro
# IDs de carpeta OneDrive/Graph. Si se dejan vacios, se usa la ruta por nombre.
ONEDRIVE_CONTRATOS=
ONEDRIVE_ANEXO_TECNICO=
CONTRATOS_ONEDRIVE_FOLDER=ContratosFirmados
CONTRATOS_BASE_URL=https://replace_frontend_contratacion.azurestaticapps.net
CONTRATOS_TOKEN_EXPIRY_HOURS=72
RECONCILIACION_CONTRATOS_EXPIRAR_HORAS=24
RECONCILIACION_CONTRATOS_JOB_HABILITADO=true
RECONCILIACION_CONTRATOS_INTERVAL_SEGUNDOS=300
# Si existen usuarios activos con rol "Talento Humano", ellos reciben estas notificaciones automaticamente.
# Usa estas variables solo como destinatarios extra o fallback temporal.
CONTRATOS_FIRMA_COMPLETADA_NOTIFY_TO=
CONTRATOS_FIRMA_NOTIFICACION_ESPERA_MINUTOS=15
ANEXO_INDIVIDUAL_NOTIFY_EMAIL=
CONTRATACIONES_DESTINO_TH=

# Contratos firmados (módulo firma de contratos)
CONTRATOS_ONEDRIVE_FOLDER=ContratosFirmados
CONTRATOS_TOKEN_EXPIRY_HOURS=72
RECONCILIACION_CONTRATOS_EXPIRAR_HORAS=24
CONTRATOS_BASE_URL=https://replace_frontend_public_url
CONTRATOS_FIRMA_COMPLETADA_NOTIFY_TO=
CONTRATOS_FIRMA_NOTIFICACION_ESPERA_MINUTOS=15
ANEXO_INDIVIDUAL_NOTIFY_EMAIL=

# Click&Sign para contratos (puede ser un config distinto al de cuentas de cobro)
CLICKSIGN_CONTRATOS_CONFIG_ID=

# Click&Sign (Lleida.net)
CLICKSIGN_API_BASE=https://api.lleida.net/cs/v1
CLICKSIGN_API_KEY=replace_clicksign_api_key
CLICKSIGN_USER=replace_clicksign_user
CLICKSIGN_CONFIG_ID=101042
CLICKSIGN_CONTRATOS_CONFIG_ID=101042
CLICKSIGN_WEBHOOK_TOKEN=replace_webhook_secret
CLICKSIGN_SIGNATURE_CB_URL=https://replace_backend_public_url/webhooks/clicksign/signature?token=replace_webhook_secret
# Fail-closed: CSV requerido para cuentas; valores admisibles: SIGNED,SIGNED_ONCE,SIGNATURE_STAMP,SIGNATORY_STAMP,SIGNATURE_PKI,SIGNATURE_BIOMETRIC
CLICKSIGN_SIGNED_FILE_GROUPS=
# Fail-closed: dejar vacio/off deshabilita cierre automatico de cuentas firmadas
CUENTAS_FIRMA_AUTOCIERRE=
CLICKSIGN_SIGNATORY_CB_URL=
CLICKSIGN_SIGNATORY_EMAIL_CB_URL=
DEBUG_CLICKSIGN_TOKEN=replace_debug_token

# Generación de contratos DOCX -> PDF (Adobe PDF Services)
ADOBE_PDF_CLIENT_ID=replace_adobe_client_id
ADOBE_PDF_CLIENT_SECRET=replace_adobe_client_secret
ADOBE_PDF_ORGANIZATION_ID=replace_adobe_organization_id
ADOBE_PDF_API_BASE=https://pdf-services.adobe.io
ADOBE_PDF_TOKEN_URL=https://pdf-services.adobe.io/token
ADOBE_PDF_SCOPE=
ADOBE_PDF_TIMEOUT_MS=60000
ADOBE_PDF_POLL_INTERVAL_MS=1500
ADOBE_PDF_POLL_TIMEOUT_MS=120000
ADOBE_PDF_RETRY_COUNT=1
# Opcional: pega el JSON completo de Adobe en una sola variable (si prefieres esto en vez de las 3 de arriba)
ADOBE_PDF_CREDENTIALS_JSON=

# Datos fijos en plantillas de contrato
CONTRATOS_REPRESENTANTE_LEGAL=DANIELA BELTRAN GOMEZ
CONTRATOS_CEDULA_REPRESENTANTE=1128472903
CONTRATOS_NIT_SILVER=901149190-0
CONTRATOS_CIUDAD_SILVER=Medellin
