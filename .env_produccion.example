# Backend
NODE_ENV=production
BACK_PORT=4000
JWT_SECRET=replace_with_random_secret
AUTH_MODE=ms_only

# Database (Azure PostgreSQL Flexible Server)
DB_USER=replace_db_user
DB_PASSWORD=replace_db_password
DB_NAME=postgres
DB_HOST=replace_flexible_server_host
DB_PORT=5432
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=false
DB_POOL_MAX=20
DB_POOL_MIN=0
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=2000
DB_POOL_KEEPALIVE=true

# CORS / Front
CORS_ORIGINS=https://replace_frontend.azurestaticapps.net
FRONT_PORTAL_BASE=https://replace_frontend.azurestaticapps.net/index.html

# Azure Entra ID / SSO
AZURE_TENANT_ID=replace_tenant_id
AZURE_CLIENT_ID=replace_client_id
AZURE_CLIENT_SECRET=replace_client_secret
AZURE_ALLOWED_GROUPS=replace_group_ids_comma_separated

# Email
EMAIL_PROVIDER=graph
EMAIL_FALLBACK_SMTP=false
GRAPH_SENDER_USER=replace_sender@company.com
EMAIL_TO_CONTABILIDAD=replace_accounting@company.com

# OneDrive
ONEDRIVE_ENABLED=true
ONEDRIVE_TARGET_USER=replace_target_user@company.com
ONEDRIVE_ROOT_FOLDER=AdjuntosCuentasCobro
