# Backend
NODE_ENV=development
BACK_ENV=development
BACK_PORT=4000
JWT_SECRET=replace_with_random_secret

# Database
DB_USER=gestion_user
DB_PASSWORD=replace_db_password
DB_NAME=gestion_tiempo
DB_HOST=db
DB_PORT=5432
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=2000
DB_POOL_KEEPALIVE=true

# Public front URL when using dev tunnels
CORS_ORIGINS=https://replace-front-tunnel-url
API_BASE=https://replace-back-tunnel-url
FRONT_PORTAL_BASE=https://replace_frontend.azurestaticapps.net/index.html

# Click&Sign (Lleida.net)
CLICKSIGN_API_BASE=https://api.lleida.net/cs/v1
CLICKSIGN_API_KEY=replace_clicksign_api_key
CLICKSIGN_USER=replace_clicksign_user
CLICKSIGN_CONFIG_ID=101042
CLICKSIGN_WEBHOOK_TOKEN=replace_webhook_secret
CLICKSIGN_SIGNATURE_CB_URL=https://replace-back-tunnel-url/webhooks/clicksign/signature?token=replace_webhook_secret
# Opcional: URL directa del PDF firmado (placeholders: {request_id}, {contract_id}, {public_id})
CLICKSIGN_SIGNED_FILE_URL_TEMPLATE=
CLICKSIGN_SIGNATORY_CB_URL=
CLICKSIGN_SIGNATORY_EMAIL_CB_URL=
DEBUG_CLICKSIGN_TOKEN=replace_debug_token
