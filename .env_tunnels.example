# Backend
NODE_ENV=development
BACK_ENV=development
BACK_PORT=4000
JWT_SECRET=replace_with_random_secret

# Database
DB_USER=gestion_user
DB_PASSWORD=replace_db_password
DB_NAME=gestion_tiempo
DB_HOST=db
DB_PORT=5432
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false
DB_POOL_MAX=10
DB_POOL_MIN=0
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=2000
DB_POOL_KEEPALIVE=true

# Public front URL when using dev tunnels
CORS_ORIGINS=https://replace-front-tunnel-url
API_BASE=https://replace-back-tunnel-url
FRONT_PORTAL_BASE=https://replace_frontend.azurestaticapps.net/index.html
